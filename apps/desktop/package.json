{
  "name": "student-markdown-knowledge-base-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "大学生个人 Markdown 笔记与知识管理工具",
  "author": "wangyizhou767, luyinuo605, Mingzi-zz",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && vitest run && electron-vite build",
    "package:dir": "electron-vite build && electron-builder --win --dir --config.directories.output=dist-check",
    "package:win": "electron-vite build && electron-builder --win portable",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "marked": "^16.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "cn.student.pkm",
    "productName": "学生 Markdown 知识库",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
